# Copy this file to .env and fill in the key for the provider you intend to use.
#
# The agent reads only the key for the selected provider. If it is missing, the
# run stops before spending a token and names the exact variable to define.

# ---------------------------------------------------------------------------
# Provider selection
# ---------------------------------------------------------------------------
# Used when --provider is not passed on the command line.
# One of: anthropic | openai | gemini | openrouter
LLM_PROVIDER=anthropic

# ---------------------------------------------------------------------------
# Credentials — one per provider
# ---------------------------------------------------------------------------
# Sharing an API shape is not sharing a credential. Gemini and OpenRouter are
# reached through an OpenAI-compatible endpoint, but each still requires its
# own key. Only the one matching LLM_PROVIDER (or --provider) is read.

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Model overrides, one per role
# ---------------------------------------------------------------------------
# anthropic and openai ship defaults for every role, so these can stay unset:
#
#   anthropic  planner/coder claude-opus-5   reviewer claude-sonnet-5
#   openai     planner/coder gpt-5.6-sol     reviewer gpt-5.6-terra
#
# gemini and openrouter are reached through the OpenAI-compatible endpoint and
# ship no default, because no default has been exercised for them here: name a
# model with --model or below. Override a role when your key has no access to a
# default — the agent reports which model it tried and which flag changes it.
#
# PLANNER_MODEL=
# CODER_MODEL=
# REVIEWER_MODEL=
