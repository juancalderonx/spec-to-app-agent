# Dependencies
node_modules/

# Build output
dist/
.vite/
*.local

# Secrets — .env.example is committed, .env is not
.env
.env.*
!.env.example

# OS
.DS_Store

# Note: generated-app/ and agent/runs/ are intentionally NOT ignored.
# The generated application and the run artifacts (plan, tool trace, error log,
# token ledger, summary) are part of the deliverable: they are what lets a
# reader inspect a real run without a key of their own. They do not make a
# re-run cheaper — there is no response cache, and the prompt cache needs a key
# like every other call.
